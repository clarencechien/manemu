// manemu — Cloudflare Workers 專案(Workers Builds 指到 app/,push 即部署)
// 一次性手動步驟見 app/README.md(R2 bucket、secrets、Google OAuth)
{
  "name": "manemu",
  "main": "src/index.mjs",
  "compatibility_date": "2026-07-01",
  // 安全:workers.dev 與 preview URL 都不經 zone WAF(繞過洞),設定碼層級關死——
  // 就算 dashboard 被誤開,下次部署也會關回來。程式端另有 CANONICAL_HOST 縱深。
  "workers_dev": false,
  "preview_urls": false,
  // 每次部署重抓 opencc-js(^ 範圍)→ 上游更新自動套用到 vendor bundle
  "build": { "command": "npm install --no-audit --no-fund && npm run vendor" },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    // 靜態檔也先進 worker:否則 canonical-host 檢查與 CSP headers 對靜態頁全部失效
    // (實測 workers.dev 首頁 200 且無安全 headers 的成因)
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "RELAY", "class_name": "RelaySession" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RelaySession"] }
  ],
  "r2_buckets": [
    { "binding": "CONFIG", "bucket_name": "manemu-config" },
    { "binding": "FIELD", "bucket_name": "manemu-field" }
  ],
  "vars": {
    // 正式網域:設了之後其他 host(含 workers.dev)一律 301/403 → WAF 繞過洞封死
    "CANONICAL_HOST": "manemu.ai-apps.work",
    // 非秘密設定;秘密(GEMINI_API_KEY / GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET / SESSION_SECRET)
    // 用 wrangler secret put 設,絕不進 repo
    // 額度分級:0 = 無上限。日後要收費就在這加級別、在 R2 白名單標人,不用改碼
    "QUOTA_TIERS": "{\"admin\":0,\"pro\":10800,\"beta\":1800,\"trial\":600}",
    "DEFAULT_TIER": "beta",
    "ADMIN_EMAILS": "clarence.chien@gmail.com",
    "DAILY_SECONDS_LIMIT": "1800",
    "SESSION_HARD_CAP_S": "120",
    "ACCURATE_MODEL": "models/gemini-3.1-flash-live-preview",
    "FAST_MODEL": "models/gemini-3.5-live-translate-preview",
    "BACKTX_MODEL": "models/gemini-3.5-flash-lite",
    // Turnstile site key 是公開值(可放 vars);TURNSTILE_SECRET 走 secret。
    // 兩者都不設 → 登入頁不出現驗證、Worker 端也不驗(方便先跑通)。
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEBVTLYxe23qYu09",
    // 個人 session 診斷端點(session 閘門後、self-scoped、無金鑰材料);封測結束改 "off"
    "DEBUG_ENDPOINT": "on",
    // 前端卡死麵包屑上報(只有階段名+時間戳,無對話內容;key 含 email)。
    // iOS 卡死已修,平時關;要追 bug 時改 "on" 再部署(隱私原則見 README「Log 與隱私」)
    "CLIENT_LOG": "off"
  },
  "observability": { "enabled": true }
}
